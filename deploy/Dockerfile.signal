# Signaling server image.
#
# Multi-stage: the builder carries the Rust toolchain and the runtime carries almost nothing. The
# resulting image is a few megabytes rather than a few hundred, which matters when you are pulling
# it onto PoPs in four regions and paying for egress in one of them.

# ---------------------------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------------------------
FROM rust:1.97-slim-bookworm AS builder

WORKDIR /build

# Dependencies are built first, from manifests alone, so editing source does not invalidate the
# dependency layer. A cold build of the `webrtc` tree takes minutes; a warm one takes seconds.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/rda-proto/Cargo.toml crates/rda-proto/
COPY crates/rda-telemetry/Cargo.toml crates/rda-telemetry/
COPY crates/rda-signal-server/Cargo.toml crates/rda-signal-server/

# Stub sources so `cargo build` can resolve and compile the dependency graph.
RUN mkdir -p crates/rda-proto/src crates/rda-telemetry/src crates/rda-signal-server/src \
 && echo 'fn main() {}' > crates/rda-signal-server/src/main.rs \
 && touch crates/rda-proto/src/lib.rs crates/rda-telemetry/src/lib.rs \
 && echo '' > crates/rda-signal-server/src/lib.rs

# Only the signaling server is needed here. Building the whole workspace would pull in the capture,
# encode and FFI crates and their platform dependencies, none of which belong on a relay host.
RUN cargo build --release -p rda-signal-server 2>/dev/null || true

# Now the real sources.
COPY crates/rda-proto crates/rda-proto
COPY crates/rda-telemetry crates/rda-telemetry
COPY crates/rda-signal-server crates/rda-signal-server

# Touch the sources so cargo rebuilds them rather than reusing the stub artefacts.
RUN find crates -name '*.rs' -exec touch {} + \
 && cargo build --release -p rda-signal-server \
 && strip target/release/rda-signal-server

# ---------------------------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------------------------
FROM debian:bookworm-slim AS runtime

# ca-certificates is needed if the server ever makes outbound TLS calls; nothing else is.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# An unprivileged user. The server binds 8080, not 443 — TLS is terminated by the reverse proxy in
# front of it (docs/PROTOCOL.md §3.1), so no capability to bind low ports is required.
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin rda

COPY --from=builder /build/target/release/rda-signal-server /usr/local/bin/rda-signal-server

USER rda
EXPOSE 8080

ENV RDA_BIND=0.0.0.0:8080 \
    RDA_LOG=info

# The health endpoint reports peer and session counts, so this doubles as a liveness signal and a
# capacity check.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/usr/local/bin/rda-signal-server", "--health-check"]

ENTRYPOINT ["/usr/local/bin/rda-signal-server"]
